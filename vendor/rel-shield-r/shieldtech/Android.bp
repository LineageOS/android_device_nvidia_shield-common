android_app_import {
    name: "NvShieldTech",
    owner: "nvidia",
    apk: ":NvShieldTech-srcs",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
}

cc_prebuilt_binary {
    name: "vendor.nvidia.hardware.shieldtech.inputflinger@2.0-service",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "vendor.nvidia.hardware.shieldtech.inputflinger@2.0-service_32-defaults",
        "vendor.nvidia.hardware.shieldtech.inputflinger@2.0-service_64-defaults",
    ],
    compile_multilib: "first",
    relative_install_path: "hw",
    soc_specific: true,
    init_rc: ["etc/init/vendor.nvidia.hardware.shieldtech.inputflinger@2.0-service.rc"],
    vintf_fragments: ["vendor.nvidia.hardware.shieldtech.inputflinger@2.0-service.xml"],
}

cc_prebuilt_binary {
    name: "vendor.nvidia.hardware.shieldtech.rpx@1.0-service",
    owner: "nvidia",
    strip: {
        none: true,
    },
    defaults: [
        "vendor.nvidia.hardware.shieldtech.rpx@1.0-service_32-defaults",
        "vendor.nvidia.hardware.shieldtech.rpx@1.0-service_64-defaults",
    ],
    compile_multilib: "first",
    relative_install_path: "hw",
    soc_specific: true,
    init_rc: ["etc/init/vendor.nvidia.hardware.shieldtech.rpx@1.0-service.rc"],
    vintf_fragments: ["vendor.nvidia.hardware.shieldtech.rpx@1.0-service.xml"],
}

prebuilt_etc_xml {
    name: "com.nvidia.shieldtech.xml",
    src: "etc/permissions/com.nvidia.shieldtech.xml",
    relative_install_path: "permissions",
    soc_specific: true,
}

prebuilt_etc_xml {
    name: "privapp-permissions-nvidia-shieldtech.xml",
    src: "etc/permissions/privapp-permissions-nvidia-shieldtech.xml",
    relative_install_path: "permissions",
}
